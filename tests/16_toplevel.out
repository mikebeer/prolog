msort([],[]).
msort([_H_121|_T_122],_S_123) :-
    msort(_T_122,_S0_124),msort_insert(_H_121,_S0_124,_S_123).

sort(_L_125,_S_126) :-
    msort(_L_125,_S0_127),dedupe_(_S0_127,_S_126).

dedupe_([],[]).
dedupe_([_X_128],[_X_128]) :-
    !.
dedupe_([_X_129,_Y_130|_T_131],_R_132) :-
    _X_129 == _Y_130,!,dedupe_([_Y_130|_T_131],_R_132).
dedupe_([_X_133,_Y_134|_T_135],[_X_133|_R_136]) :-
    dedupe_([_Y_134|_T_135],_R_136).

concat_atom([],'').
concat_atom([_A_137],_A_137) :-
    !.
concat_atom([_A_138|_T_139],_R_140) :-
    concat_atom(_T_139,_R0_141),atom_concat(_A_138,_R0_141,_R_140).

